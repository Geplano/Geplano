# Environment Variables Template
# Copie este arquivo para .env.local e preencha os valores

# Branch do repositório (normalmente 'main' ou 'master')
NEXT_PUBLIC_BRANCH=main

# TinaCMS Cloud - OPCIONAL (apenas se quiser painel /admin em produção)
# Deixe vazio para modo self-hosted (edição via GitHub)
# Obtenha em https://app.tina.io/
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Segredo para proteger o endpoint de revalidação
# Gere um token seguro com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# URL pública do site
# Desenvolvimento: http://localhost:3000
# Produção: https://seu-dominio.com (será preenchido automaticamente no Vercel)
NEXT_PUBLIC_URL=
